# The Framework owns hooks, input, rendering and the PhysFS profile.
# This target links the Multiplayer logic without a second loader or MinHook runtime.
# MT2_FRAMEWORK_SDK and MT2_FRAMEWORK_VENDOR come from cmake/framework_pin.cmake.
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "The Multiplayer Framework plugin requires Windows x64")
endif()
enable_language(ASM_MASM)
set(IMGUI_DIR "${CMAKE_CURRENT_SOURCE_DIR}/include/vendor/imgui")
add_library(mp_imgui STATIC
    "${IMGUI_DIR}/imgui.cpp" "${IMGUI_DIR}/imgui_demo.cpp"
    "${IMGUI_DIR}/imgui_draw.cpp" "${IMGUI_DIR}/imgui_tables.cpp"
    "${IMGUI_DIR}/imgui_widgets.cpp"
    "${IMGUI_DIR}/backends/imgui_impl_sdl3.cpp"
    "${IMGUI_DIR}/backends/imgui_impl_opengl3.cpp")
target_include_directories(mp_imgui PUBLIC "${IMGUI_DIR}" "${IMGUI_DIR}/backends"
    "${MT2_FRAMEWORK_VENDOR}/SDL3/include")
target_link_libraries(mp_imgui PUBLIC opengl32 "${MT2_FRAMEWORK_VENDOR}/SDL3/lib/x64/SDL3.lib")
file(GLOB_RECURSE MP_SOURCES CONFIGURE_DEPENDS
    src/core/*.cpp src/hooks/*.cpp src/net/*.cpp src/sync/*.cpp src/overlay/*.cpp src/game/*.cpp)
add_library(MT2MultiplayerPlugin SHARED ${MP_SOURCES}
    src/game/object_identity/native_lease/native_free/native_free_bridges.asm
    src/game/toon_time_fence/camera_gate.asm)
# "vendor/nlohmann/json.hpp" and "vendor/minhook/include/MinHook.h" resolve against the SDK's third_party.
target_include_directories(MT2MultiplayerPlugin PRIVATE include src/game include/vendor/steam
    "${MT2_FRAMEWORK_SDK}/third_party" "${MT2_FRAMEWORK_VENDOR}/minhook/include"
    "${MT2_FRAMEWORK_SDK}/include" "${MT2_FRAMEWORK_SDK}/adapters/mt2/sdk")
target_compile_definitions(MT2MultiplayerPlugin PRIVATE MT2MP_FRAMEWORK_PLUGIN
    MT2MP_EXPORTS NOMINMAX WIN32_LEAN_AND_MEAN ${MT2_FRAMEWORK_VERSION_DEFINITIONS})
target_link_libraries(MT2MultiplayerPlugin PRIVATE mp_imgui opengl32 ws2_32 bcrypt version)
if(MSVC)
    target_compile_options(MT2MultiplayerPlugin PRIVATE
        "$<$<COMPILE_LANGUAGE:CXX>:/MP2>" "$<$<COMPILE_LANGUAGE:CXX>:/utf-8>")
    if(MT2MP_CI_FORCE_HEADER)
        set(forced_header "${CMAKE_CURRENT_BINARY_DIR}/ci_force_header.hxx")
        file(GENERATE OUTPUT "${forced_header}" CONTENT "/* generated by CMake */\n\n#pragma system_header\n#ifdef __cplusplus\n#include \"${MT2_FRAMEWORK_VENDOR}/nlohmann/json.hpp\"\n#endif // __cplusplus\n")
        foreach(source IN LISTS MP_SOURCES)
            if(NOT source MATCHES "[/\\\\]src[/\\\\]core[/\\\\]config\\.cpp$")
                set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_OPTIONS "/FI${forced_header}")
            endif()
        endforeach()
    else()
        target_precompile_headers(MT2MultiplayerPlugin PRIVATE
            "$<$<COMPILE_LANGUAGE:CXX>:${MT2_FRAMEWORK_VENDOR}/nlohmann/json.hpp>")
    endif()
endif()
# Relay process of the local two-client test (tools/framework_local_test.py).
add_executable(mt2mp_sidecar tools/sidecar/mt2mp_sidecar_main.cpp)
target_compile_definitions(mt2mp_sidecar PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
target_include_directories(mt2mp_sidecar PRIVATE include)
target_link_libraries(mt2mp_sidecar PRIVATE ws2_32)
set_target_properties(mt2mp_sidecar PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
option(MT2MP_BUILD_TESTS "Build tests" ON)
if(MT2MP_BUILD_TESTS)
    enable_testing()
    add_subdirectory(ci)
endif()
