# Extract complete production decisions; native boundaries are mocked by the tests.
set(auto_world_source "${MT2MP_SOURCE_ROOT}/src/game/native_lobby.cpp")
set(prepare_world_source "${MT2MP_SOURCE_ROOT}/src/game/prepare_flow.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${auto_world_source}" "${prepare_world_source}")
file(READ "${auto_world_source}" auto_world_text)
file(READ "${prepare_world_source}" prepare_world_text)

function(mt2mp_auto_world_body source_variable first last output)
    string(FIND "${${source_variable}}" "${first}" body_begin)
    string(FIND "${${source_variable}}" "${last}" body_end)
    if(body_begin LESS 0 OR body_end LESS body_begin)
        message(FATAL_ERROR "Current-world source boundaries changed for ${output}")
    endif()
    math(EXPR body_size "${body_end}-${body_begin}")
    string(SUBSTRING "${${source_variable}}" ${body_begin} ${body_size} body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${output}" "${body}")
endfunction()

mt2mp_auto_world_body(auto_world_text "bool fail(const std::string& detail)" "// All string storage" auto_world_failure_body.inc)
