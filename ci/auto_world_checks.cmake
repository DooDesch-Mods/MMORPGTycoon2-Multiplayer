        "reinterpret_cast<void(*)(void*,const void*,float)>(image+0x6757d0)(receiver,&caption,0.0f)"
        "image+0x11bd1e0)(&caption)" "if(!code)code=GetExceptionCode()")
    string(FIND "${button_call}" "${required}" required_at)
    if(required_at LESS 0)
        message(FATAL_ERROR "Native Button caption ABI/lifetime boundary changed: ${required}")
    endif()
endforeach()
