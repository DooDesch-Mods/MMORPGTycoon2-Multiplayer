if(WIN32)
    add_executable(test_reporting ../test/test_reporting.cpp ../src/core/reporting.cpp ../src/core/logger.cpp ../src/core/config.cpp)
    target_include_directories(test_reporting PRIVATE ../include)
    target_compile_definitions(test_reporting PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN MT2MP_REPORTING_TEST)
    target_compile_options(test_reporting PRIVATE /utf-8)
