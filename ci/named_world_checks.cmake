if(WIN32)
    set(named_world_source "${MT2MP_SOURCE_ROOT}/src/game/native_engine.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${named_world_source}")
    file(READ "${named_world_source}" named_world_text)
    set(named_world_bodies "")
    function(named_world_extract begin end suffix)
        string(FIND "${named_world_text}" "${begin}" first)
        string(FIND "${named_world_text}" "${end}" last)
        if(first LESS 0 OR last LESS first)
            message(FATAL_ERROR "Named-world actual body boundaries changed: ${begin}")
        endif()
        math(EXPR count "${last}-${first}")
        string(SUBSTRING "${named_world_text}" ${first} ${count} body)
        set(named_world_bodies "${named_world_bodies}\n${body}${suffix}\n" PARENT_SCOPE)
    endfunction()
    named_world_extract("struct AtomicSoftwareTickCounters {" "// Policy and object identities" "")
    named_world_extract("struct SoftwareReplica {" "struct AtomicNeedsWrites {" "")
    named_world_extract("bool check_thread(" "bool hash_executable(" "")
    named_world_extract("bool valid_test_name(" "\n}\n}\n\nbool initialize(" "\n}\n")
    named_world_extract("SoftwareTickGuard software_receiver_guard(" "DWORD store_software_cache(" "")
    named_world_extract("const char* software_tick_guard_name(" "SoftwareTickGuard observe_software_tick(" "")
    named_world_extract("bool arm_software_replica(" "\nnamespace {\nbool subscriber_login_read(" "")
    named_world_extract("bool request_load(" "bool dispatch_command(" "")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/named_world_bodies.inc" "${named_world_bodies}")
    if(NOT DEFINED NAMED_WORLD_TEST_SOURCE)
        set(NAMED_WORLD_TEST_SOURCE "${MT2MP_SOURCE_ROOT}/test/test_named_world.cpp")
    endif()
    add_executable(test_named_world "${NAMED_WORLD_TEST_SOURCE}")
    target_include_directories(test_named_world PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${MT2MP_SOURCE_ROOT}/include" "${MT2MP_SOURCE_ROOT}")
    target_compile_definitions(test_named_world PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    if(MSVC)
        target_compile_options(test_named_world PRIVATE /W4 /WX /utf-8)
    endif()
    add_test(NAME named_world COMMAND test_named_world)
    set_tests_properties(named_world PROPERTIES TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
endif()
