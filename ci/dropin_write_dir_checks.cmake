if(WIN32)
    set(loader_source "${MT2MP_SOURCE_ROOT}/proxy/wsock32_loader.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${loader_source}")
    file(READ "${loader_source}" loader_text)
    string(FIND "${loader_text}" "int private_write_dir(" write_begin)
    string(FIND "${loader_text}" "void callbacks()" write_end)
    if(write_begin LESS 0 OR write_end LESS write_begin)
        message(FATAL_ERROR "Private PhysFS caller boundaries changed; update the affected body test")
    endif()
    math(EXPR write_size "${write_end}-${write_begin}")
    string(SUBSTRING "${loader_text}" ${write_begin} ${write_size} write_body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/private_write_dir_body.inc" "${write_body}")
    add_executable(test_dropin_write_dir "${MT2MP_SOURCE_ROOT}/test/test_dropin_write_dir.cpp")
    target_include_directories(test_dropin_write_dir PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${MT2MP_SOURCE_ROOT}/include")
    target_compile_definitions(test_dropin_write_dir PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    target_link_libraries(test_dropin_write_dir PRIVATE bcrypt)
    if(MSVC)
        target_compile_options(test_dropin_write_dir PRIVATE /W4 /WX /utf-8)
    endif()
    add_test(NAME dropin_write_dir COMMAND test_dropin_write_dir)
    set_tests_properties(dropin_write_dir PROPERTIES TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
endif()
