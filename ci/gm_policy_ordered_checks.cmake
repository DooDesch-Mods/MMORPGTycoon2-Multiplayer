function(policy_body start end output)
    string(FIND "${policy_runtime}" "${start}" first)
    string(FIND "${policy_runtime}" "${end}" last)
    if(first LESS 0 OR last LESS_EQUAL first)
        message(FATAL_ERROR "GM policy production body boundary missing: ${output}")
    endif()
    math(EXPR bytes "${last}-${first}")
    string(SUBSTRING "${policy_runtime}" ${first} ${bytes} body)
    file(WRITE "${POLICY_ORDERED_GENERATED}/${output}" "${body}")
endfunction()
