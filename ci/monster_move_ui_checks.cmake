foreach(name info ui_native)
    set(target "test_monster_move_${name}")
    add_executable(${target} "${MT2MP_SOURCE_ROOT}/test/${target}.cpp")
    target_include_directories(${target} PRIVATE "${MONSTER_MOVE_UI_GENERATED}" "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
    target_compile_features(${target} PRIVATE cxx_std_20)
    target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(${target} PRIVATE /W4 /WX /utf-8 /EHsc)
    add_test(NAME monster_move_${name} COMMAND ${target})
    set_tests_properties(monster_move_${name} PROPERTIES TIMEOUT 60)
endforeach()
