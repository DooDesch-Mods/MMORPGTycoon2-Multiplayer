set(MONSTER_MOVE_UI_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/monster_move_ui")
file(MAKE_DIRECTORY "${MONSTER_MOVE_UI_GENERATED}")
function(monster_move_ui_body path begin end output)
    file(READ "${MT2MP_SOURCE_ROOT}/${path}" text)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MT2MP_SOURCE_ROOT}/${path}")
    string(FIND "${text}" "${begin}" first)
    if(end STREQUAL "EOF_NAMESPACE" OR end STREQUAL "EOF")
        string(LENGTH "${text}" last)
        if(end STREQUAL "EOF_NAMESPACE")
            math(EXPR last "${last}-2")
        endif()
    else()
        string(FIND "${text}" "${end}" last)
    endif()
    math(EXPR length "${last}-${first}")
    if(first LESS 0 OR length LESS 1)
        message(FATAL_ERROR "Actual Monster Move UI body extraction differs: ${output}")
    endif()
    string(SUBSTRING "${text}" ${first} ${length} body)
    set(destination "${MONSTER_MOVE_UI_GENERATED}/${output}")
    if(EXISTS "${destination}")
        file(READ "${destination}" previous)
    else()
        set(previous "")
    endif()
    if(NOT previous STREQUAL body)
        file(WRITE "${destination}" "${body}")
    endif()
endfunction()
