set(research_native_source "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/research_native.inc")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${research_native_source}")
file(READ "${research_native_source}" research_native_body)
string(FIND "${research_native_body}" "bool research_projection(" research_projection_begin)
if(research_projection_begin LESS 0)
    message(FATAL_ERROR "Research actual projection/adoption extraction boundary changed")
endif()
string(SUBSTRING "${research_native_body}" ${research_projection_begin} -1 research_adoption_body)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/research_native_extracted")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/research_native_extracted/research_adoption_body.inc" "${research_adoption_body}")
set(research_public_source "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/research_public.inc")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${research_public_source}")
file(READ "${research_public_source}" research_public_body)
string(FIND "${research_public_body}" "bool retain_research_commit_effect(" research_effect_begin)
if(research_effect_begin LESS 0)
    message(FATAL_ERROR "Research actual effect receipt extraction boundary changed")
endif()
string(SUBSTRING "${research_public_body}" ${research_effect_begin} -1 research_effect_body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/research_native_extracted/research_effect_body.inc" "${research_effect_body}")
foreach(name IN ITEMS release adoption)
    add_executable(test_research_${name} "${MT2MP_SOURCE_ROOT}/test/test_research_${name}.cpp")
    target_include_directories(test_research_${name} PRIVATE "${MT2MP_SOURCE_ROOT}/include" "${MT2MP_SOURCE_ROOT}/src/game" "${CMAKE_CURRENT_BINARY_DIR}/research_native_extracted")
    target_compile_features(test_research_${name} PRIVATE cxx_std_20)
    if(MSVC)
        target_compile_options(test_research_${name} PRIVATE /W4 /WX /utf-8 /EHsc)
    endif()
    add_test(NAME research_${name} COMMAND test_research_${name})
    set_tests_properties(research_${name} PROPERTIES TIMEOUT 60)
endforeach()
target_sources(test_research_adoption PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/startingpoint.cpp")
