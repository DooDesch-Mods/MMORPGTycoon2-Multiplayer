if(NOT DEFINED TIME_RETIRE_SOURCE)
    set(TIME_RETIRE_SOURCE "${MT2MP_SOURCE_ROOT}/src/core/dll_main.cpp")
endif()
if(NOT DEFINED TIME_RETIRE_TEST)
    set(TIME_RETIRE_TEST "${MT2MP_SOURCE_ROOT}/test/test_cold_time_retire.cpp")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${TIME_RETIRE_SOURCE}")
file(READ "${TIME_RETIRE_SOURCE}" source)
string(FIND "${source}" "static bool suspend_time(" body_begin)
string(FIND "${source}" "static std::string load_clock_key" body_end)
if(body_begin LESS 0 OR body_end LESS body_begin)
    message(FATAL_ERROR "Time retirement source boundaries changed")
endif()
math(EXPR body_size "${body_end}-${body_begin}")
string(SUBSTRING "${source}" ${body_begin} ${body_size} body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/cold_time_retire_body.inc" "${body}")
add_executable(test_cold_time_retire "${TIME_RETIRE_TEST}")
target_include_directories(test_cold_time_retire PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
if(MSVC)
    target_compile_options(test_cold_time_retire PRIVATE /W4 /WX /utf-8)
endif()
add_test(NAME cold_time_retire COMMAND test_cold_time_retire)
set_tests_properties(cold_time_retire PROPERTIES TIMEOUT 60)
