set(MONSTER_PREPARE_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/monster_prepare")
file(MAKE_DIRECTORY "${MONSTER_PREPARE_GENERATED}")
set(MONSTER_PREPARE_SOURCE "${MT2MP_SOURCE_ROOT}/src/game/monster_action_runtime.inc")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MONSTER_PREPARE_SOURCE}")
file(READ "${MONSTER_PREPARE_SOURCE}" MONSTER_PREPARE_NATIVE)
foreach(body activation_readback monster_prepare)
    if(body STREQUAL "activation_readback")
        string(FIND "${MONSTER_PREPARE_NATIVE}" "struct ActivationReadback {" BEGIN)
        string(FIND "${MONSTER_PREPARE_NATIVE}" "uint32_t activate(" END)
    else()
        string(FIND "${MONSTER_PREPARE_NATIVE}" "bool prepare(" BEGIN)
        string(FIND "${MONSTER_PREPARE_NATIVE}" "void release_entry(void* receiver" END)
    endif()
    math(EXPR LENGTH "${END}-${BEGIN}")
    if(BEGIN LESS 0 OR LENGTH LESS 1)
        message(FATAL_ERROR "Actual Monster preparation extraction boundary changed: ${body}")
    endif()
    string(SUBSTRING "${MONSTER_PREPARE_NATIVE}" ${BEGIN} ${LENGTH} BODY)
    file(WRITE "${MONSTER_PREPARE_GENERATED}/${body}.inc" "${BODY}")
endforeach()
add_executable(test_monster_prepare "${MT2MP_SOURCE_ROOT}/test/test_monster_prepare.cpp")
target_include_directories(test_monster_prepare PRIVATE "${MONSTER_PREPARE_GENERATED}" "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
target_compile_features(test_monster_prepare PRIVATE cxx_std_20)
target_compile_definitions(test_monster_prepare PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_compile_options(test_monster_prepare PRIVATE /W4 /WX /utf-8 /EHsc)
add_test(NAME monster_prepare COMMAND test_monster_prepare)
set_tests_properties(monster_prepare PROPERTIES TIMEOUT 60)
