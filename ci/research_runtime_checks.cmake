set(research_runtime_source "${MT2MP_SOURCE_ROOT}/src/game/typed_action_runtime.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${research_runtime_source}")
file(READ "${research_runtime_source}" research_runtime_text)
string(FIND "${research_runtime_text}" "    struct CommitOperation {" research_runtime_begin)
string(FIND "${research_runtime_text}" "    action::Outcome perform_staff(" research_runtime_end)
if(research_runtime_begin LESS 0 OR research_runtime_end LESS research_runtime_begin)
    message(FATAL_ERROR "Research runtime extraction boundaries changed")
endif()
math(EXPR research_runtime_size "${research_runtime_end}-${research_runtime_begin}")
string(SUBSTRING "${research_runtime_text}" ${research_runtime_begin} ${research_runtime_size} research_runtime_body)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/research_runtime_extracted")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/research_runtime_extracted/research_runtime.inc" "${research_runtime_body}")
string(FIND "${research_runtime_text}" "    bool observe_commit(" research_observation_begin)
string(FIND "${research_runtime_text}" "    world_state::Table world_;" research_observation_end)
if(research_observation_begin LESS 0 OR research_observation_end LESS research_observation_begin)
    message(FATAL_ERROR "Research observation extraction boundaries changed")
endif()
math(EXPR research_observation_size "${research_observation_end}-${research_observation_begin}")
string(SUBSTRING "${research_runtime_text}" ${research_observation_begin} ${research_observation_size} research_observation_body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/research_runtime_extracted/research_observation.inc" "${research_observation_body}")
add_executable(test_research_runtime "${MT2MP_SOURCE_ROOT}/test/test_research_runtime.cpp"
    "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/startingpoint.cpp")
target_include_directories(test_research_runtime PRIVATE "${MT2MP_SOURCE_ROOT}/src/game"
    "${MT2MP_SOURCE_ROOT}/include" "${CMAKE_CURRENT_BINARY_DIR}/research_runtime_extracted")
target_compile_features(test_research_runtime PRIVATE cxx_std_20)
if(MSVC)
    target_compile_options(test_research_runtime PRIVATE /W4 /WX /utf-8 /EHsc)
endif()
add_test(NAME research_runtime COMMAND test_research_runtime)
set_tests_properties(research_runtime PROPERTIES TIMEOUT 60)
