if(WIN32)
    set(loader_source "${MT2MP_SOURCE_ROOT}/proxy/wsock32_loader.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${loader_source}")
    file(READ "${loader_source}" loader_text)
    string(FIND "${loader_text}" "int private_mount(" mount_begin)
    string(FIND "${loader_text}" "int private_write_dir(" mount_end)
    if(mount_begin LESS 0 OR mount_end LESS mount_begin)
        message(FATAL_ERROR "Original-save mount caller boundaries changed; update the affected body test")
    endif()
    math(EXPR mount_size "${mount_end}-${mount_begin}")
    string(SUBSTRING "${loader_text}" ${mount_begin} ${mount_size} mount_body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/loader_mount_body.inc" "${mount_body}")
    add_executable(test_original_saves "${MT2MP_SOURCE_ROOT}/test/test_original_saves.cpp")
    target_include_directories(test_original_saves PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${MT2MP_SOURCE_ROOT}/include")
    target_compile_definitions(test_original_saves PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
    target_link_libraries(test_original_saves PRIVATE bcrypt)
    if(MSVC)
        target_compile_options(test_original_saves PRIVATE /W4 /WX /utf-8)
    endif()
    add_test(NAME original_saves COMMAND test_original_saves "${CMAKE_CURRENT_BINARY_DIR}/original-saves-fixtures")
    set_tests_properties(original_saves PROPERTIES TIMEOUT 60 WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
endif()
