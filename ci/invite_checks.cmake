if(NOT DEFINED INVITE_SOURCE)
    set(INVITE_SOURCE "${MT2MP_SOURCE_ROOT}/src/game/native_lobby.cpp")
endif()
if(NOT DEFINED INVITE_TEST_SOURCE)
    set(INVITE_TEST_SOURCE "${MT2MP_SOURCE_ROOT}/test/test_native_invite.cpp")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${INVITE_SOURCE}")
file(READ "${INVITE_SOURCE}" invite_text)
foreach(kind failure command)
    if(kind STREQUAL failure)
        set(first "bool fail(const std::string& detail)")
        set(last "bool metadata_failure(")
    else()
        set(first "    if(cmd==\"MT2MPInvite\") {")
        set(last "    fail(\"unknown native lobby command ")
    endif()
    string(FIND "${invite_text}" "${first}" body_begin)
    string(FIND "${invite_text}" "${last}" body_end)
    if(body_begin LESS 0 OR body_end LESS body_begin)
        message(FATAL_ERROR "Native Invite source boundaries changed: ${kind}")
    endif()
    math(EXPR body_size "${body_end}-${body_begin}")
    string(SUBSTRING "${invite_text}" ${body_begin} ${body_size} body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/invite_${kind}_body.inc" "${body}")
endforeach()
add_executable(test_native_invite "${INVITE_TEST_SOURCE}")
target_include_directories(test_native_invite PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
if(MSVC)
    target_compile_options(test_native_invite PRIVATE /W4 /WX /utf-8)
endif()
add_test(NAME native_invite COMMAND test_native_invite)
set_tests_properties(native_invite PROPERTIES TIMEOUT 60)
