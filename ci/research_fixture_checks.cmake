set(research_fixture_source "${MT2MP_SOURCE_ROOT}/src/game/tutorial_startingpoint_fixture/startingpoint_fixture.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${research_fixture_source}")
file(READ "${research_fixture_source}" research_fixture_body)
string(FIND "${research_fixture_body}" "bool before_research(" research_guard_begin)
string(FIND "${research_fixture_body}" "#include \"begin_fixture.inc\"" research_guard_end)
if(research_guard_begin LESS 0 OR research_guard_end LESS research_guard_begin)
    message(FATAL_ERROR "Research begin guard extraction boundaries changed")
endif()
math(EXPR research_guard_size "${research_guard_end}-${research_guard_begin}")
string(SUBSTRING "${research_fixture_body}" ${research_guard_begin} ${research_guard_size} research_begin_guard)
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/research_fixture_extracted")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/research_fixture_extracted/research_begin_guard.inc" "${research_begin_guard}")
target_include_directories(test_tutorial_client_research_ui PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/research_fixture_extracted")
