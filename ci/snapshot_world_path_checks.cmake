set(world_folder_source "${MT2MP_SOURCE_ROOT}/src/game/native_engine.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${world_folder_source}")
file(READ "${world_folder_source}" world_folder_text)
string(FIND "${world_folder_text}" "bool read_active_world_folder(" folder_begin)
string(FIND "${world_folder_text}" "bool capture_snapshot(" folder_end)
if(folder_begin LESS 0 OR folder_end LESS folder_begin)
    message(FATAL_ERROR "Native world-folder reader boundaries changed; update the affected body test")
endif()
math(EXPR folder_size "${folder_end}-${folder_begin}")
string(SUBSTRING "${world_folder_text}" ${folder_begin} ${folder_size} folder_body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/snapshot_world_folder_body.inc" "${folder_body}")
add_executable(test_snapshot_world_folder "${MT2MP_SOURCE_ROOT}/test/test_snapshot_world_folder.cpp")
target_include_directories(test_snapshot_world_folder PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${MT2MP_SOURCE_ROOT}/include")
if(MSVC)
    target_compile_options(test_snapshot_world_folder PRIVATE /W4 /WX /utf-8)
endif()
add_test(NAME snapshot_world_folder COMMAND test_snapshot_world_folder)
