if(NOT TARGET source_check_codecs_windows)
    include("${CMAKE_CURRENT_LIST_DIR}/shared_codec_checks.cmake")
endif()
add_library(control_session_checks STATIC "${MT2MP_SOURCE_ROOT}/src/game/typed_action/action_session.cpp")
target_include_directories(control_session_checks PRIVATE "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
target_compile_features(control_session_checks PRIVATE cxx_std_20)
target_compile_definitions(control_session_checks PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
if(MSVC)
    target_compile_options(control_session_checks PRIVATE /utf-8 /EHsc /W4 /WX)
endif()
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(_control_generated "${CMAKE_CURRENT_BINARY_DIR}/control_fragment_generated")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${MT2MP_SOURCE_ROOT}/test/extract_frame_fragment_boundary.py"
    --root "${MT2MP_SOURCE_ROOT}" --output "${_control_generated}" COMMAND_ERROR_IS_FATAL ANY)
foreach(name intervention_protocol intervention_frame)
    add_executable(control_${name} "${MT2MP_SOURCE_ROOT}/test/test_${name}.cpp")
    target_include_directories(control_${name} PRIVATE "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include" "${_control_generated}")
    target_compile_features(control_${name} PRIVATE cxx_std_20)
    target_compile_definitions(control_${name} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(control_${name} PRIVATE control_session_checks source_check_codecs_windows bcrypt)
    if(MSVC)
        target_compile_options(control_${name} PRIVATE /utf-8 /EHsc /W4 /WX)
    endif()
    add_test(NAME control_${name} COMMAND control_${name})
endforeach()
