file(READ "${MT2MP_SOURCE_ROOT}/src/game/game_rules_runtime.inc" game_rules_runtime)
function(game_rules_body start end output)
    string(FIND "${game_rules_runtime}" "${start}" first)
    string(FIND "${game_rules_runtime}" "${end}" last)
    if(first LESS 0 OR last LESS_EQUAL first)
        message(FATAL_ERROR "Game rules production body boundary missing: ${output}")
    endif()
    math(EXPR bytes "${last}-${first}")
    string(SUBSTRING "${game_rules_runtime}" ${first} ${bytes} body)
    file(WRITE "${GAME_RULES_ORDERED_GENERATED}/${output}" "${body}")
endfunction()
