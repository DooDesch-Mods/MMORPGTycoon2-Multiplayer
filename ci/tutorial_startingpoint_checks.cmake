set(startingpoint_source "${MT2MP_SOURCE_ROOT}/src/game/tutorial_startingpoint_fixture/startingpoint_fixture.cpp")
set(startingpoint_baseline "${MT2MP_SOURCE_ROOT}/docs/evidence/tutorial-development-native.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${startingpoint_source}" "${startingpoint_baseline}")
file(READ "${startingpoint_source}" source)
string(FIND "${source}" "bool same(const World&" pin_begin)
string(FIND "${source}" "bool pin(" pin_end)
string(FIND "${source}" "bool before(" guard_begin)
string(FIND "${source}" "struct BorrowedString" guard_end)
if(pin_begin LESS 0 OR pin_end LESS pin_begin OR guard_begin LESS 0 OR guard_end LESS guard_begin)
    message(FATAL_ERROR "Startingpoint native guard boundaries changed")
endif()
math(EXPR pin_size "${pin_end}-${pin_begin}")
math(EXPR guard_size "${guard_end}-${guard_begin}")
string(SUBSTRING "${source}" ${pin_begin} ${pin_size} pin_body)
string(SUBSTRING "${source}" ${guard_begin} ${guard_size} guard_body)
file(READ "${startingpoint_baseline}" baseline)
string(JSON native_baseline GET "${baseline}" development host)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/startingpoint_guards.inc"
    "${pin_body}\n${guard_body}\ninline const auto native_baseline=json::parse(R\"receipt(${native_baseline})receipt\");\n")
add_executable(test_tutorial_startingpoint "${MT2MP_SOURCE_ROOT}/test/test_tutorial_startingpoint.cpp")
target_include_directories(test_tutorial_startingpoint PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
target_compile_features(test_tutorial_startingpoint PRIVATE cxx_std_20)
if(MSVC)
    target_compile_options(test_tutorial_startingpoint PRIVATE /W4 /WX /utf-8 /EHsc)
endif()
add_test(NAME tutorial_startingpoint COMMAND test_tutorial_startingpoint)
set_tests_properties(tutorial_startingpoint PROPERTIES TIMEOUT 60)
