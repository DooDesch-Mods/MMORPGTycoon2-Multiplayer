set(DIRECT_MONSTER_MOVE_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/direct_monster_move")
file(MAKE_DIRECTORY "${DIRECT_MONSTER_MOVE_GENERATED}")
set(DIRECT_MONSTER_MOVE_SOURCE "${MT2MP_SOURCE_ROOT}/src/game/monster_move_runtime.inc")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DIRECT_MONSTER_MOVE_SOURCE}")
file(READ "${DIRECT_MONSTER_MOVE_SOURCE}" DIRECT_MONSTER_MOVE_NATIVE)
string(FIND "${DIRECT_MONSTER_MOVE_NATIVE}" "a::Outcome move_perform(" DIRECT_MONSTER_MOVE_BEGIN)
if(DIRECT_MONSTER_MOVE_BEGIN LESS 0)
    message(FATAL_ERROR "MoveMonster actual perform body anchor missing")
endif()
string(SUBSTRING "${DIRECT_MONSTER_MOVE_NATIVE}" ${DIRECT_MONSTER_MOVE_BEGIN} -1 DIRECT_MONSTER_MOVE_BODY)
file(WRITE "${DIRECT_MONSTER_MOVE_GENERATED}/monster_move_native_body.inc" "${DIRECT_MONSTER_MOVE_BODY}")

foreach(name protocol controller identity_visibility capture native)
    set(target "test_direct_monster_move_${name}")
    add_executable(${target} "${MT2MP_SOURCE_ROOT}/test/${target}.cpp")
    if(name STREQUAL "protocol" OR name STREQUAL "controller")
        target_sources(${target} PRIVATE
            "${MT2MP_SOURCE_ROOT}/src/game/typed_action/action_session.cpp"
            "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/startingpoint.cpp"
            "${MT2MP_SOURCE_ROOT}/src/game/developer_staff/shared_state.cpp")
    elseif(name STREQUAL "capture")
        target_sources(${target} PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/move_kiss/move_kiss.cpp")
    endif()
    target_include_directories(${target} PRIVATE "${DIRECT_MONSTER_MOVE_GENERATED}" "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
    target_compile_features(${target} PRIVATE cxx_std_20)
    target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(${target} PRIVATE /W4 /WX /utf-8 /EHsc)
    add_test(NAME direct_monster_move_${name} COMMAND ${target})
    set_tests_properties(direct_monster_move_${name} PROPERTIES TIMEOUT 60)
endforeach()
