target_include_directories(test_prepare_sync_failure PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${MT2MP_SOURCE_ROOT}/include")
target_compile_features(test_prepare_sync_failure PRIVATE cxx_std_20)
if(MSVC)
    target_compile_options(test_prepare_sync_failure PRIVATE /W4 /WX /utf-8)
endif()
add_test(NAME prepare_sync_failure COMMAND test_prepare_sync_failure)
