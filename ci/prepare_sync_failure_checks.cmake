set(sync_failure_prepare "${MT2MP_SOURCE_ROOT}/src/game/prepare_flow.cpp")
set(sync_failure_runtime "${MT2MP_SOURCE_ROOT}/src/game/typed_action_runtime.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sync_failure_prepare}" "${sync_failure_runtime}")
file(READ "${sync_failure_prepare}" sync_failure_prepare_text)
file(READ "${sync_failure_runtime}" sync_failure_runtime_text)
function(mt2mp_sync_failure_body variable first last output)
    string(FIND "${${variable}}" "${first}" first_index)
    string(FIND "${${variable}}" "${last}" last_index)
    if(first_index LESS 0 OR last_index LESS first_index)
        message(FATAL_ERROR "Prepare sync-failure extraction boundaries changed: ${output}")
    endif()
    math(EXPR length "${last_index}-${first_index}")
    string(SUBSTRING "${${variable}}" ${first_index} ${length} body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${output}" "${body}")
endfunction()
mt2mp_sync_failure_body(sync_failure_runtime_text "json controller_status() {" "json status() {" sync_failure_controller.inc)
mt2mp_sync_failure_body(sync_failure_prepare_text "enum class Step" "bool terrain_ready()" sync_failure_state.inc)
mt2mp_sync_failure_body(sync_failure_prepare_text "bool completed(" "bool all_ack(" sync_failure_completed.inc)
mt2mp_sync_failure_body(sync_failure_prepare_text "bool prepare(const std::string& path" "bool leave(" sync_failure_entry.inc)
mt2mp_sync_failure_body(sync_failure_prepare_text "bool leave(" "bool tick(std::string& error)" sync_failure_leave.inc)
mt2mp_sync_failure_body(sync_failure_prepare_text "bool tick(std::string& error)" "nlohmann::json status()" sync_failure_tick.inc)
# The final namespace close is kept with the actual status function.
string(FIND "${sync_failure_prepare_text}" "nlohmann::json status()" status_index)
if(status_index LESS 0)
    message(FATAL_ERROR "Prepare sync-failure status boundary changed")
endif()
string(SUBSTRING "${sync_failure_prepare_text}" ${status_index} -1 status_body)
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/sync_failure_status.inc" "${status_body}")
