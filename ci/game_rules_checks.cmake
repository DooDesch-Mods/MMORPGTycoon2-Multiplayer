foreach(name game_rules game_rules_protocol gm_policy_protocol gm_frame)
    if(TARGET test_${name})
        continue()
    endif()
    add_executable(test_${name} "${MT2MP_SOURCE_ROOT}/test/test_${name}.cpp")
    if(name STREQUAL "game_rules")
        target_sources(test_${name} PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/game_rules_native.cpp")
    endif()
    target_link_libraries(test_${name} PRIVATE game_rules_session_checks)
    if(MSVC)
        target_compile_options(test_${name} PRIVATE /utf-8 /EHsc /W4 /WX)
    endif()
    add_test(NAME ${name} COMMAND test_${name})
    set_tests_properties(${name} PROPERTIES TIMEOUT 60)
endforeach()
