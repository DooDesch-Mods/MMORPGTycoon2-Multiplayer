if(TARGET gm_policy_session_checks)
    add_library(game_rules_session_checks INTERFACE)
    target_link_libraries(game_rules_session_checks INTERFACE gm_policy_session_checks)
elseif(TARGET world_edit_session_checks)
    add_library(game_rules_session_checks INTERFACE)
    target_link_libraries(game_rules_session_checks INTERFACE world_edit_session_checks source_check_codecs_windows)
    target_include_directories(game_rules_session_checks INTERFACE "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
    target_compile_features(game_rules_session_checks INTERFACE cxx_std_20)
    target_compile_definitions(game_rules_session_checks INTERFACE NOMINMAX WIN32_LEAN_AND_MEAN)
else()
    add_library(game_rules_session_checks STATIC
        "${MT2MP_SOURCE_ROOT}/src/game/typed_action/action_session.cpp"
        "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/startingpoint.cpp"
        "${MT2MP_SOURCE_ROOT}/src/game/developer_staff/shared_state.cpp"
        "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/state.cpp"
        "${MT2MP_SOURCE_ROOT}/src/game/live_host_state/state.cpp"
        "${MT2MP_SOURCE_ROOT}/src/game/live_host_state/network/node_state.cpp")
