set(host_departure_local "${MT2MP_SOURCE_ROOT}/src/net/local_session.cpp")
set(host_departure_lobby "${MT2MP_SOURCE_ROOT}/src/game/native_lobby.cpp")
set(host_departure_wire "${MT2MP_SOURCE_ROOT}/src/net/session_wire.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${host_departure_local}" "${host_departure_lobby}" "${host_departure_wire}")
function(host_departure_extract path first last output)
    file(READ "${path}" text)
    string(FIND "${text}" "${first}" begin)
    string(FIND "${text}" "${last}" end REVERSE)
    if(begin LESS 0 OR end LESS begin)
        message(FATAL_ERROR "Host departure production body boundaries changed: ${output}")
    endif()
    math(EXPR length "${end}-${begin}")
    string(SUBSTRING "${text}" ${begin} ${length} body)
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/${output}" "${body}\n")
endfunction()
host_departure_extract("${host_departure_local}" "namespace mt2mp::net {" "} // namespace mt2mp::net" host_departure_local_body.inc)
host_departure_extract("${host_departure_lobby}" "bool retire_departed_host(" "bool tick(std::string& error) {" host_departure_lobby_body.inc)
host_departure_extract("${host_departure_wire}" "bool retire_lobby(std::string& error){" "\n}" host_departure_wire_body.inc)
add_executable(test_host_departure "${MT2MP_SOURCE_ROOT}/test/test_host_departure.cpp")
target_include_directories(test_host_departure PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" "${MT2MP_SOURCE_ROOT}/include")
if(MSVC)
    target_compile_options(test_host_departure PRIVATE /W4 /WX /utf-8)
endif()
add_test(NAME host_departure COMMAND test_host_departure)
set_tests_properties(host_departure PROPERTIES TIMEOUT 30)
