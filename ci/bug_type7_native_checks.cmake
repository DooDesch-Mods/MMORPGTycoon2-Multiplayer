if(WIN32)
    foreach(group links birth retire work_parent)
        if(group STREQUAL "work_parent")
            set(type7_target test_bug_work_parent)
        else()
            set(type7_target test_bug_job_${group})
        endif()
        add_executable(${type7_target} "${MT2MP_SOURCE_ROOT}/test/${type7_target}.cpp")
        target_compile_features(${type7_target} PRIVATE cxx_std_20)
        target_compile_options(${type7_target} PRIVATE /W4 /WX /EHsc /bigobj)
        target_compile_definitions(${type7_target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
        target_include_directories(${type7_target} PRIVATE "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
        add_test(NAME bug_type7_${group} COMMAND ${type7_target})
    endforeach()

    set(job_native_source "${MT2MP_SOURCE_ROOT}/src/game/bug_authority/job_native.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${job_native_source}")
    file(READ "${job_native_source}" job_native_text)
    set(job_native_extracted "")
    foreach(part owner authorize detach)
        if(part STREQUAL "owner")
            set(first "struct PairOwner{")
            set(last "\n}\nbool verify_job_calls")
        elseif(part STREQUAL "authorize")
            set(first "bool NativeJobBirth::authorize(")
            set(last "bool NativeJobBirth::observe(")
        else()
            set(first "bool NativeJobBirth::detach(")
            set(last "bool NativeJobBirth::erase(")
        endif()
        string(FIND "${job_native_text}" "${first}" begin)
        string(FIND "${job_native_text}" "${last}" end)
        if(begin LESS 0 OR end LESS_EQUAL begin)
            message(FATAL_ERROR "Bug native pair extraction boundary missing: ${part}")
        endif()
        math(EXPR length "${end}-${begin}")
        string(SUBSTRING "${job_native_text}" ${begin} ${length} body)
        string(APPEND job_native_extracted "${body}\n")
    endforeach()
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/bug_job_native_pair_actual.inc" "${job_native_extracted}")
    target_include_directories(test_bug_job_links PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
    target_sources(test_bug_job_links PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/subscriber_lifecycle/cohort.cpp")
    target_sources(test_bug_job_birth PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/bug_authority/job_birth.cpp" "${MT2MP_SOURCE_ROOT}/src/game/developer_staff/job_census.cpp")
    target_sources(test_bug_job_retire PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/bug_authority/job_retire.cpp")
    target_sources(test_bug_work_parent PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/bug_authority/parent_visual.cpp")
endif()
