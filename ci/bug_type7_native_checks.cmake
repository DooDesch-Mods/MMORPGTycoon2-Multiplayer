if(WIN32)
    foreach(group links birth retire work_parent)
        if(group STREQUAL "work_parent")
            set(type7_target test_bug_work_parent)
        else()
            set(type7_target test_bug_job_${group})
        endif()
        add_executable(${type7_target} "${MT2MP_SOURCE_ROOT}/test/${type7_target}.cpp")
        target_compile_features(${type7_target} PRIVATE cxx_std_20)
        target_compile_options(${type7_target} PRIVATE /W4 /WX /EHsc /bigobj)
        target_compile_definitions(${type7_target} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX)
        target_include_directories(${type7_target} PRIVATE "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
        add_test(NAME bug_type7_${group} COMMAND ${type7_target})
    endforeach()
    target_sources(test_bug_job_links PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/subscriber_lifecycle/cohort.cpp")
    target_sources(test_bug_job_birth PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/bug_authority/job_birth.cpp" "${MT2MP_SOURCE_ROOT}/src/game/developer_staff/job_census.cpp")
    target_sources(test_bug_job_retire PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/bug_authority/job_retire.cpp")
    target_sources(test_bug_work_parent PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/bug_authority/parent_visual.cpp")
endif()
