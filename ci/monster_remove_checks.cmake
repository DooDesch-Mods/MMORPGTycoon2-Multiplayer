foreach(name protocol controller read capture native absence quest_retirement ui)
    set(target "test_monster_remove_${name}")
    add_executable(${target} "${MT2MP_SOURCE_ROOT}/test/${target}.cpp")
    if(name STREQUAL "protocol" OR name STREQUAL "controller")
        target_sources(${target} PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/typed_action/action_session.cpp"
            "${MT2MP_SOURCE_ROOT}/src/game/tutorial_replication/startingpoint.cpp"
            "${MT2MP_SOURCE_ROOT}/src/game/developer_staff/shared_state.cpp")
    elseif(name STREQUAL "capture" OR name STREQUAL "native")
        target_sources(${target} PRIVATE "${MT2MP_SOURCE_ROOT}/src/game/ui_remove/ui_capture.cpp")
    endif()
    target_include_directories(${target} PRIVATE "${MONSTER_REMOVE_GENERATED}" "${MT2MP_SOURCE_ROOT}/src/game" "${MT2MP_SOURCE_ROOT}/include")
    target_compile_features(${target} PRIVATE cxx_std_20)
    target_compile_definitions(${target} PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_compile_options(${target} PRIVATE /W4 /WX /utf-8 /EHsc)
    add_test(NAME monster_remove_${name} COMMAND ${target})
    set_tests_properties(monster_remove_${name} PROPERTIES TIMEOUT 60)
endforeach()
