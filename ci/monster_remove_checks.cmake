set(MONSTER_REMOVE_GENERATED "${CMAKE_CURRENT_BINARY_DIR}/monster_remove")
file(MAKE_DIRECTORY "${MONSTER_REMOVE_GENERATED}")
function(monster_remove_body path begin end output)
    file(READ "${MT2MP_SOURCE_ROOT}/${path}" text)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MT2MP_SOURCE_ROOT}/${path}")
    string(FIND "${text}" "${begin}" first)
    string(FIND "${text}" "${end}" last)
    math(EXPR length "${last}-${first}")
    if(first LESS 0 OR length LESS 1)
        message(FATAL_ERROR "Actual Monster Remove extraction boundary differs: ${output}")
    endif()
    string(SUBSTRING "${text}" ${first} ${length} body)
    set(destination "${MONSTER_REMOVE_GENERATED}/${output}")
    if(EXISTS "${destination}")
        file(READ "${destination}" previous)
    else()
        set(previous "")
    endif()
    if(NOT previous STREQUAL body)
        file(WRITE "${destination}" "${body}")
    endif()
endfunction()
