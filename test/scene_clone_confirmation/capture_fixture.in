#include <algorithm>
#include <cstdint>
#include <functional>
#include <iostream>
#include <memory>
#include <optional>
#include <set>
#include <stdexcept>
#include <string>
#include <vector>
namespace action_session {
enum class Role {Host,Client};
struct Context {Role role=Role::Host;bool operator==(const Context&)const=default;};
struct Binding {int generation=1;bool operator==(const Binding&)const=default;};
}
namespace scene_clone {struct Mapping {std::string operation;};}
namespace dungeon_scene_identity_runtime {struct Census {};}
unsigned GetCurrentThreadId(){return 1;}
bool fail(std::string& error,const std::string& cause){error=cause;return false;}
struct SceneRuntime {
    struct State {bool prepared=false,locked=false;unsigned thread=1;action_session::Context context;action_session::Binding binding;std::set<std::string> operations;};
    std::unique_ptr<State> state_=std::make_unique<State>();
    unsigned prepares=0,confirms=0,publications=0,fail_prepare=0,fail_confirm=0;
    bool current(const action_session::Context&,const action_session::Binding&,std::string&){return true;}
    bool prepare(const action_session::Context&,const action_session::Binding&,std::string& e){
        ++prepares;if(prepares==fail_prepare)return fail(e,"fixture native preparation failed");state_->prepared=true;e.clear();return true;
    }
    bool confirm(const action_session::Context& context,const action_session::Binding& binding,const std::string& operation,
        const scene_clone::Mapping* authority,scene_clone::Mapping& out,dungeon_scene_identity_runtime::Census& admitted,bool& attempted,std::string& e){
        ++confirms;out={};admitted={};attempted=false;
        @CONFIRM_GUARD@
        if(confirms==fail_confirm)return fail(e,"fixture original census failed");
        @CONSUME_PREPARATION@
        state_->operations.insert(operation);++publications;out.operation=operation;attempted=true;e.clear();return true;
    }
};
namespace life {
struct Event {bool action=false;std::string operation;};
struct Pin {std::string key;int counter=0;};
struct Host {std::vector<int> pending(){return {};}};
bool append(Host&,int,const Event&,std::string&){return true;}
std::vector<int> indices(const Pin&){return {};}
}
namespace dungeon_instance_native {
bool drain(const std::string&,std::vector<life::Event>& events,std::vector<life::Pin>& pools,std::string& error){events.clear();pools.clear();error.clear();return true;}
}
namespace party_live {struct Record {};}
struct Encoded {std::string dump()const{return "record";}};
Encoded encode_record(const party_live::Record&){return {};}
struct Parties {
    bool current_records(const action_session::Context&,const action_session::Binding&,int,std::vector<party_live::Record>& records,std::string& error){records.push_back({});error.clear();return true;}
};
struct Instance {std::string scene;};
namespace dungeon_instance_live {
struct Row {Instance state;};struct Census {std::vector<Row> rows;};
bool take_current(const action_session::Context&,const action_session::Binding&,Census&,std::string& error){error.clear();return true;}
}
struct State {
    struct Pool {std::string exterior;int counter;std::vector<int> indices;};
    std::optional<scene_clone::Mapping> scenes;std::vector<std::string> parties;std::vector<Instance> instances;std::vector<Pool> pools;std::vector<int> lifecycle;
};
bool valid(const State&,std::string& error){error.clear();return true;}
namespace live_host_state {
namespace apply_timing {
enum class Part {HostPartyScenePrepare,HostPartyNativeBatch,HostPartyDrain,HostPartySceneConfirm,HostPartyBirths,HostPartyPins};
struct Scope {explicit Scope(Part){}};
}
struct Frame {uint64_t revision=1;};
struct PartyPort {
    virtual bool prepare_capture(const action_session::Context&,const action_session::Binding&,uint64_t,std::string&)=0;
    virtual bool capture(const action_session::Context&,const action_session::Binding&,const Frame&,State&,std::string&)=0;
};
}
std::string operation(){static unsigned value=0;return "operation-"+std::to_string(++value);}
struct NativeFixture:live_host_state::PartyPort {
    SceneRuntime scenes_;std::optional<scene_clone::Mapping> scene_mapping_;
    Parties parties_;life::Host host_;int origin_=1;std::optional<int> dungeon_building_;
    std::string capture_operation_;uint64_t capture_revision_=0;unsigned birth_ordinal_=0;
    std::set<std::string> host_actions_;unsigned batches=0,fail_batch=0,rejections=0;bool unknown=false;
    bool context(const action_session::Context&,const action_session::Binding&,std::string& e){e.clear();return true;}
    bool host_batch(const std::function<bool(std::string&)>& body,std::string& e){++batches;if(batches==fail_batch)return fail(e,"fixture original batch failed");return body(e);}
    bool births(std::string& e){e.clear();return true;}
    bool pins(std::string& e){e.clear();return true;}
    int references(){return 0;}
    bool reject(std::string& e,const std::string& cause,bool attempted){++rejections;unknown=attempted;return fail(e,cause);}
};
class Baseline final:public NativeFixture {public:
@BASELINE_METHODS@
};
class Candidate final:public NativeFixture {public:
@CANDIDATE_METHODS@
};
unsigned checks=0;
void check(bool value,const std::string& cause){++checks;if(!value)throw std::runtime_error(cause);}
int main(){try{action_session::Context context;action_session::Binding binding;live_host_state::Frame frame;std::string error;State output;
    Baseline before;
    check(before.prepare_capture(context,binding,frame.revision,error),error);
    check(!before.capture(context,binding,frame,output,error),"original missing preparation no longer reproduces");
    check(error=="Scene clone confirmation token/current bound preparation differs","original guard cause changed");
    check(before.scenes_.prepares==1&&before.scenes_.confirms==2&&before.scenes_.publications==1,"baseline must fail at second confirm before publication");
    Candidate after;
    check(after.prepare_capture(context,binding,frame.revision,error),error);
    check(after.capture(context,binding,frame,output,error),error);
    check(after.scenes_.prepares==2&&after.scenes_.confirms==2&&after.scenes_.publications==2&&after.batches==2,"each original drained batch needs fresh preparation");
    check(output.scenes&&output.scenes->operation==after.scene_mapping_->operation,"final scene mapping not handed to Frame");
    check(!after.scenes_.state_->prepared,"successful confirmation did not consume preparation");
    Candidate pending;pending.dungeon_building_=1;
    check(!pending.prepare_capture(context,binding,frame.revision,error)&&error=="Party Frame capture waits for the exact Dungeon Building scene phase","pending Dungeon Building scene guard lost");
    check(pending.scenes_.prepares==0&&pending.batches==0&&pending.scenes_.publications==0,"pending Dungeon Building reached capture work");
    Candidate preparation;
    check(preparation.prepare_capture(context,binding,1,error),error);preparation.scenes_.fail_prepare=2;
    check(!preparation.capture(context,binding,frame,output,error)&&error=="fixture native preparation failed","prepare failure lost");
    check(preparation.batches==1&&preparation.scenes_.confirms==1,"prepare failure still ran original native batch");
    Candidate batch;
    check(batch.prepare_capture(context,binding,1,error),error);batch.fail_batch=2;
    check(!batch.capture(context,binding,frame,output,error)&&error=="fixture original batch failed","batch failure lost");
    check(batch.scenes_.prepares==2&&batch.scenes_.confirms==1&&batch.scenes_.publications==1,"failed original batch reached confirmation");
    Candidate census;
    check(census.prepare_capture(context,binding,1,error),error);census.scenes_.fail_confirm=2;
    check(!census.capture(context,binding,frame,output,error)&&error=="fixture original census failed","confirmation failure lost");
    check(census.rejections==1&&!census.unknown&&census.scenes_.publications==1,"unpublished failure incorrectly marked published");
    scene_clone::Mapping mapping;dungeon_scene_identity_runtime::Census admitted;bool attempted=false;
    check(!after.scenes_.confirm(context,binding,"unprepared",nullptr,mapping,admitted,attempted,error)&&!attempted,"unprepared confirm guard weakened");
    check(after.scenes_.prepare(context,binding,error),error);
    const auto reused=*after.scenes_.state_->operations.begin();
    check(!after.scenes_.confirm(context,binding,reused,nullptr,mapping,admitted,attempted,error)&&!attempted,"reused operation guard weakened");
    std::cout<<checks<<" extracted Party Scene capture checks passed\n";return 0;
}catch(const std::exception& exception){std::cerr<<"check "<<checks<<": "<<exception.what()<<'\n';return 1;}}
