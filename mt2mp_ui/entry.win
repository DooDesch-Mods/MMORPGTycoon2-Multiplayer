mmoDesktopIcon
{
    id "entry_button";
    dims 100 82;
    anchorType TopLeft;
    clickable true;
    label 100;
    icon 101;
    content
    {
        mmoPane
        {
            linkId 101;
            id "multiplayer_icon";
            dims 48 48;
            anchorType Top;
            material "mt2mp_desktop_multiplayer";
            clickable true;
        }
        mmoTextEditPane
        {
            linkId 100;
            id "title";
            dims 120 32;
            anchorType Top;
            anchorPos 0 50;
            text "Multiplayer";
            justify topcenter;
            textSize 14;
            selectableUnfocused true;
            clickable true;
        }
    }
}
