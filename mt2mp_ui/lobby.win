mmoWindow
{
	id "mt2mp_lobby";
	dims 700 640;
	anchorType Window;
	anchorPos 120 40;
	hasTitlebar true;
	title "Multiplayer";
	material "PanelBacking";
	corners "BottomRight";
	cornerSize 12;
	hideOnEscape true;
	transitionType rez;
	rezSpeed normal;
	content
	{
		mmoTextEditPane
		{
			id "status";
			text "Multiplayer";
			dims 668 24;
			anchorType TopLeft;
			anchorPos 16 10;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoButtonPane
		{
			id "host";
			text "Für Freunde hosten";
			dims 200 36;
			anchorType TopLeft;
			anchorPos 16 50;
			textSize 16;
			clickable true;
			border true;
			edges All;
			corners "TopLeft BottomRight";
			cornerSize 8;
			command "MessageTo Mode MT2MPHost";
		}
		mmoButtonPane
		{
			id "host_public";
			text "Öffentlich hosten";
			dims 200 36;
			anchorType TopLeft;
			anchorPos 232 50;
			textSize 16;
			clickable true;
			border true;
			edges All;
			corners "TopLeft BottomRight";
			cornerSize 8;
			command "MessageTo Mode MT2MPHostPublic";
		}
		mmoButtonPane
		{
			id "search";
			text "Spiel suchen";
			dims 236 36;
			anchorType TopLeft;
			anchorPos 448 50;
			textSize 16;
			clickable true;
			border true;
			edges All;
			corners "TopLeft BottomRight";
			cornerSize 8;
			command "MessageTo Mode MT2MPSearch";
		}
		mmoButtonPane
		{
			id "join";
			text "Beitreten";
			dims 236 36;
			anchorType TopLeft;
			anchorPos 448 96;
			textSize 16;
			clickable true;
			border true;
			edges All;
			corners "TopLeft BottomRight";
			cornerSize 8;
			command "MessageTo Mode MT2MPJoin";
		}
		mmoButtonPane
		{
			id "invite";
			text "Freunde einladen";
			dims 300 36;
			anchorType TopLeft;
			anchorPos 16 96;
			textSize 16;
			clickable true;
			border true;
			edges All;
			corners "TopLeft BottomRight";
			cornerSize 8;
			command "MessageTo Mode MT2MPInvite";
		}
		mmoTextEditPane
		{
			id "world";
			text "Keine Welt ausgewählt";
			dims 668 24;
			anchorType TopLeft;
			anchorPos 16 158;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoButtonPane
		{
			id "pick";
