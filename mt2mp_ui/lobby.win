			dims 300 36;
			anchorType TopLeft;
			anchorPos 16 192;
			textSize 16;
			clickable true;
			border true;
			edges All;
			corners "TopLeft BottomRight";
			cornerSize 8;
			command "MessageTo Mode MT2MPPickWorld";
		}
		mmoTextEditPane
		{
			id "lobby_id_label";
			text "Lobby-ID";
			dims 100 24;
			anchorType TopLeft;
			anchorPos 16 102;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoTextEditPane
		{
			id "lobby_id";
			text "";
			dims 300 30;
			anchorType TopLeft;
			anchorPos 128 99;
			editable true;
			clickable true;
			maxLength 20;
			border true;
			edges All;
			material "DarkGrey";
		}
		mmoTextEditPane
		{
			id "player0";
