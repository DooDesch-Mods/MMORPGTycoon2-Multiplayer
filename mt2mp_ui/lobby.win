			dims 324 24;
			anchorType TopLeft;
			anchorPos 16 258;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoTextEditPane
		{
			id "player1";
			text "Freier Platz";
			dims 324 24;
			anchorType TopLeft;
			anchorPos 356 258;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoTextEditPane
		{
			id "player2";
			text "Freier Platz";
			dims 324 24;
			anchorType TopLeft;
			anchorPos 16 286;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoTextEditPane
		{
			id "player3";
			text "Freier Platz";
			dims 324 24;
			anchorType TopLeft;
			anchorPos 356 286;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoTextEditPane
		{
			id "chat_status";
			text "Chat - zuerst Lobby beitreten";
			dims 668 22;
			anchorType TopLeft;
			anchorPos 16 324;
			textSize 16;
			editable false;
			clickable false;
			justify left;
			border false;
		}
		mmoTextEditPane
		{
			id "chat_transcript";
			text "";
			dims 668 148;
			anchorType TopLeft;
			anchorPos 16 350;
			textSize 14;
			editable false;
			clickable false;
			justify left;
			border true;
			edges All;
			material "DarkGrey";
		}
		mmoTextEditPane
		{
			id "chat_input";
			text "";
			dims 552 32;
			anchorType TopLeft;
			anchorPos 16 512;
			textSize 16;
			editable true;
			clickable true;
			maxLength 240;
			border true;
			edges All;
			material "DarkGrey";
		}
		mmoButtonPane
		{
			id "chat_send";
			text "Senden";
			dims 100 32;
			anchorType TopLeft;
			anchorPos 584 512;
			textSize 16;
			clickable true;
			border true;
