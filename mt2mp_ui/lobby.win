			cornerSize 8;
			command "MessageTo Mode MT2MPChatSend";
		}
		mmoButtonPane
		{
			id "start";
			text "Welt laden und starten";
			dims 416 36;
			anchorType TopLeft;
			anchorPos 16 576;
			textSize 16;
			clickable true;
			border true;
