        if(ap==r.image+0x1737870){if(!q::at(r.memory,node,0xb8,uid,e))return false;const auto found=make_buildings.find(uid);if(found==make_buildings.end()||!made_buildings.insert(uid).second||!duplicate_edit::history_building_inverse(r,node,found->second,e))return q::fail(e,e.empty()?"Modular graph original Building Make differs":e);continue;}
        if(ap==r.image+0x16de860){if(!q::at(r.memory,node,0xb8,uid,e)||!destroy.contains(uid)||!destroyed.insert(uid).second||!scenery_make_history::destroy(r.memory,r.image,node,uid,e))return q::fail(e,e.empty()?"Modular graph original Destroy is foreign/repeated":e);continue;}
        if(ap==r.image+0x1786fb0){action::DuplicateCash value;uintptr_t method=0;if(!q::at(r.memory,ap,0x10,method,e)||method!=r.image+0x53ccf0||!q::at(r.memory,node,0xb8,value.amount,e)||!q::at(r.memory,node,0xbc,value.position,e)||!scenery_make_history::uid_set(r.memory,node+8,0,e)||!scenery_make_history::uid_set(r.memory,node+0x30,0,e)||!scenery_make_history::uid_set(r.memory,node+0x58,0,e))return false;checked.cash.push_back(value);continue;}
