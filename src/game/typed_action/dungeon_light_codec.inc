bool valid_dungeon_light_intent(const DungeonLightIntent& v){if(!key(v.key)||!digest(v.before_sha256))return false;for(const auto& color:v.input.colors)for(float x:color)if(!std::isfinite(x))return false;for(float x:v.light)if(!std::isfinite(x))return false;return true;}
json dungeon_light_input_json(const DungeonLightInput& v){return {{"spinners",v.spinners},{"sliders",v.sliders},{"colors",v.colors}};}
DungeonLightInput dungeon_light_input_read(const json& j){exact(j,{"spinners","sliders","colors"});DungeonLightInput v;ability_array(j.at("spinners"),v.spinners,i32);ability_array(j.at("sliders"),v.sliders,i32);
    if(!j.at("colors").is_array()||j.at("colors").size()!=4)throw std::runtime_error("Dungeon light color input dimension differs");for(size_t i=0;i<4;++i)ability_array(j.at("colors")[i],v.colors[i],scalar);return v;}
json dungeon_light_intent_json(const DungeonLightIntent& v){return {{"key",v.key},{"before_sha256",v.before_sha256},{"input",dungeon_light_input_json(v.input)},{"light",v.light}};}
DungeonLightIntent dungeon_light_intent_read(const json& j){exact(j,{"key","before_sha256","input","light"});DungeonLightIntent v;v.key=j.at("key").get<std::string>();v.before_sha256=j.at("before_sha256").get<std::string>();v.input=dungeon_light_input_read(j.at("input"));ability_array(j.at("light"),v.light,scalar);return v;}
bool valid_dungeon_light_state(const DungeonLightState& v){if(v==DungeonLightState{})return true;if(!valid_dungeon_config_state(v.dungeon))return false;for(float x:v.light)if(!std::isfinite(x))return false;return true;}
json dungeon_light_state_json(const DungeonLightState& v){if(v==DungeonLightState{})return nullptr;return {{"dungeon",dungeon_config_state_json(v.dungeon)},{"light",v.light}};}
DungeonLightState dungeon_light_state_read(const json& j){if(j.is_null())return {};exact(j,{"dungeon","light"});DungeonLightState v;v.dungeon=dungeon_config_state_read(j.at("dungeon"));ability_array(j.at("light"),v.light,scalar);return v;}
