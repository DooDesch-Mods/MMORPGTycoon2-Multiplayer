bool modular_history(const Request& r){return (r.action==Action::UndoBuilding||r.action==Action::RedoBuilding)&&uuid(r.target_action_uuid)&&r.canonical_record_key=="modular:"+r.target_action_uuid;}
bool modular_action(const Request& r){return r.action==Action::EditModularBuilding||modular_history(r);}
bool modular_valid(const ModularIntent& v){std::string e;return game::modular_transition::valid(v,[](const auto& value){return key(value);},e);}
json modular_json(const ModularIntent& v){return json::array({v.mode,v.region,v.target,v.before_record_sha,v.theme,v.position,v.pose,v.clearance,v.layout,v.plan});}
ModularIntent modular_read(const json& j){if(!j.is_array()||j.size()!=10)throw std::runtime_error("Modular exact original input width differs");const auto mode=u64(j[0]);if(mode>4)throw std::runtime_error("Modular mode differs");ModularIntent v;v.mode=uint8_t(mode);v.region=i32(j[1]);v.target=j[2].get<std::string>();v.before_record_sha=j[3].get<std::string>();v.theme=j[4].get<std::string>();v.position=duplicate_bits<3>(j[5]);v.pose=duplicate_bits<10>(j[6]);v.clearance=duplicate_bits<6>(j[7]);v.layout=j[8];v.plan=j[9];if(!modular_valid(v))throw std::runtime_error("Modular complete original input invalid");return v;}
json modular_result_json(const std::optional<ModularEffect>& v){if(!v)return nullptr;auto changes=json::array();for(const auto& row:v->changed)changes.push_back(json::array({duplicate_objects({row[0]})[0],duplicate_objects({row[1]})[0]}));return json::array({duplicate_objects(v->removed),duplicate_objects(v->created),changes,duplicate_cash_json(v->cash),v->untouched_sha,v->dependency_sha,v->related_buildings});}
std::optional<ModularEffect> modular_result_read(const json& j){if(j.is_null())return {};if(!j.is_array()||j.size()!=7||!j[0].is_array()||!j[1].is_array()||!j[2].is_array()||j[0].size()>max_payload||j[1].size()>max_payload||j[2].size()>max_payload||!j[5].is_array()||j[5].size()!=4||!j[6].is_array()||j[6].size()>max_payload)throw std::runtime_error("Modular complete result extent differs");ModularEffect v;for(const auto& row:j[0])v.removed.push_back(scenery_stroke_object(row));for(const auto& row:j[1])v.created.push_back(scenery_stroke_object(row));for(const auto& row:j[2]){if(!row.is_array()||row.size()!=2)throw std::runtime_error("Modular changed owner pair differs");v.changed.push_back({scenery_stroke_object(row[0]),scenery_stroke_object(row[1])});}v.cash=duplicate_cash_read(j[3]);v.untouched_sha=j[4].get<std::string>();for(size_t i=0;i<4;++i)v.dependency_sha[i]=j[5][i].get<std::string>();for(const auto& owner:j[6])v.related_buildings.push_back(owner.get<std::string>());std::string e;if(!game::modular_transition::valid(v,[](const auto& value){return key(value);},e))throw std::runtime_error(e);return v;}
bool modular_effect(const Request& r,const Evidence& e){
    if(!modular_action(r)||!e.modular_before||!e.modular_after||!e.modular_result||!scenery_stroke_state_valid(*e.modular_before)||!scenery_stroke_state_valid(*e.modular_after)||!e.undo_confirmed||!e.selection_confirmed||e.object_before!=BuildingState{}||e.object_after!=BuildingState{})return false;
    const auto& result=*e.modular_result;std::string cause;if(!game::modular_transition::valid(result,[](const auto& value){return key(value);},cause))return false;
    if(result.removed.empty()&&result.created.empty()&&result.changed.empty())return false;
    if(modular_history(r)){
        if(e.modular_before->release!=e.modular_after->release)return false;
        if(result.removed.empty()&&result.created.empty()){if(result.changed.size()!=1||!result.cash.empty()||!result.related_buildings.empty()||result.dependency_sha[0]!=result.dependency_sha[2]||result.dependency_sha[1]!=result.dependency_sha[3])return false;const auto& row=result.changed.front();return row[0].family==DuplicateFamily::Building&&row[1].family==DuplicateFamily::Building&&row[0].parent==row[1].parent&&e.before==e.after;}
        const bool undo=r.action==Action::UndoBuilding;const auto& buildings=undo?result.removed:result.created;const auto& scenery=undo?result.created:result.removed;
        if(buildings.size()!=1||buildings.front().family!=DuplicateFamily::Building||buildings.front().key!="action:"+r.target_action_uuid||result.cash.size()!=1)return false;
        for(const auto& row:scenery)if(row.family!=DuplicateFamily::Scenery)return false;
        for(const auto& row:result.changed)if(row[0].pose!=row[1].pose||row[0].parent!=row[1].parent||(row[0].family!=DuplicateFamily::Group&&(row[0].family!=DuplicateFamily::Building||std::find(result.related_buildings.begin(),result.related_buildings.end(),row[0].key)==result.related_buildings.end())))return false;
        if(undo?result.cash.front().amount<0:result.cash.front().amount>0)return false;
        return game::duplicate_history::ledger(e.before,e.after,result.cash);
    }
    if(!modular_valid(r.modular)||e.target_retired||!result.related_buildings.empty()||result.dependency_sha[1]!=result.dependency_sha[3])return false;
    const auto& before=*e.modular_before;const auto& after=*e.modular_after;
    for(size_t i=0;i<8;++i)if(int64_t(after.release[i])-before.release[i]!=int64_t(i==1))return false;
    if(r.modular.mode){if(!result.removed.empty()||!result.created.empty()||result.changed.size()!=1||!result.cash.empty()||result.dependency_sha[0]!=result.dependency_sha[2])return false;const auto& change=result.changed.front();return change[0].key==r.modular.target&&change[0].record_sha==r.modular.before_record_sha&&change[0].family==DuplicateFamily::Building&&change[1].family==DuplicateFamily::Building&&change[0].parent==change[1].parent&&e.before==e.after;}
    if(result.created.size()!=1||result.created[0].family!=DuplicateFamily::Building||result.created[0].key!="action:"+r.action_uuid||result.created[0].region!=r.modular.region||result.cash.empty())return false;
    for(const auto& row:result.removed)if(row.family!=DuplicateFamily::Scenery)return false;for(const auto& row:result.changed)if(row[0].family!=DuplicateFamily::Group||row[0].pose!=row[1].pose)return false;
    int64_t amount=0;for(const auto& cash:result.cash){if(cash.amount<0)return false;amount+=cash.amount;}auto expected=e.before;
    const auto add=[](int32_t& value,int64_t delta){const auto next=int64_t(value)+delta;if(next<INT32_MIN||next>INT32_MAX)return false;value=int32_t(next);return true;};
    if(amount&&(!expected.record_present||!add(expected.cash,-amount)||!add(expected.record_cash,-amount)||!add(expected.record_expense,amount)||!add(expected.line_counts[6],1)||!add(expected.line_income[6],-amount)))return false;return expected==e.after;
}
