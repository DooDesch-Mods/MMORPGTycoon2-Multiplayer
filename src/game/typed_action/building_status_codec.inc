bool valid_building_status_intent(const BuildingStatusIntent& v){return key(v.key)&&v.before>=0&&v.before<=2&&v.state>=0&&v.state<=2;}
json building_status_intent_json(const BuildingStatusIntent& v){return {{"key",v.key},{"before",v.before},{"state",v.state},{"dungeon_ui",v.dungeon_ui}};}
BuildingStatusIntent building_status_intent_read(const json& j){exact(j,{"key","before","state","dungeon_ui"});return {j.at("key").get<std::string>(),i32(j.at("before")),i32(j.at("state")),ability_bool(j.at("dungeon_ui"))};}
bool valid_building_status_state(const BuildingStatusState& v){return v==BuildingStatusState{}||(v.state>=0&&v.state<=2&&v.construction>=0&&v.construction<=1000000&&std::isfinite(v.bandwidth)&&v.bandwidth>=0&&v.bugs<=1000000&&v.jobs<=1000000&&v.linked<=v.bugs&&v.developers<=1000&&v.undo_count<=20&&digest(v.bugs_sha256)&&digest(v.expected_bugs_sha256)&&digest(v.pool_sha256));}
json building_status_state_json(const BuildingStatusState& v){if(v==BuildingStatusState{})return nullptr;return {{"state",v.state},{"construction",v.construction},{"bandwidth",v.bandwidth},{"user_set",v.user_set},{"dungeon",v.dungeon},{"dungeon_ready",v.dungeon_ready},{"bugs",v.bugs},{"jobs",v.jobs},{"linked",v.linked},{"developers",v.developers},{"bugs_sha256",v.bugs_sha256},{"expected_bugs_sha256",v.expected_bugs_sha256},{"pool_sha256",v.pool_sha256},{"undo_count",v.undo_count},{"global_random",v.global_random}};}
BuildingStatusState building_status_state_read(const json& j){if(j.is_null())return {};exact(j,{"state","construction","bandwidth","user_set","dungeon","dungeon_ready","bugs","jobs","linked","developers","bugs_sha256","expected_bugs_sha256","pool_sha256","undo_count","global_random"});BuildingStatusState v;
    v.state=i32(j.at("state"));v.construction=i32(j.at("construction"));v.bandwidth=scalar(j.at("bandwidth"));v.user_set=ability_bool(j.at("user_set"));v.dungeon=ability_bool(j.at("dungeon"));v.dungeon_ready=ability_bool(j.at("dungeon_ready"));
    auto count=[&](const char* name){auto value=u64(j.at(name));if(value>1000000)throw std::runtime_error("Building status census exceeds bound");return uint32_t(value);};
    v.bugs=count("bugs");v.jobs=count("jobs");v.linked=count("linked");v.developers=count("developers");v.bugs_sha256=j.at("bugs_sha256").get<std::string>();v.expected_bugs_sha256=j.at("expected_bugs_sha256").get<std::string>();v.pool_sha256=j.at("pool_sha256").get<std::string>();v.undo_count=u64(j.at("undo_count"));ability_array(j.at("global_random"),v.global_random,u64);return v;}
